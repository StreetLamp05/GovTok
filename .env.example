# Copy to .env.local (git-ignored) and fill in. Never commit values.

# Written by `npx convex dev`; leave them empty and let the CLI fill them.
# scripts/worktree-setup.sh replaces them with a local deployment in each worktree.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Browser (shipped to the client; also set in Vercel)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Server (copied onto the Convex deployment by scripts/convex-env.sh [--prod])
GOOGLE_GEOCODING_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GROQ_API_KEY=
ADMIN_PASSCODE=

# CONVEX_DEPLOY_KEY lives only in Vercel (Production). Keep it out of this file.
